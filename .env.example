# Sunucu Portu (PaaS servisleri otomatik atar, VPS için varsayılan 3000)
PORT=3000

# Node Ortamı (production / development)
NODE_ENV=production

# JWT İmzalamak için gizli anahtar (En az 32 karakter rastgele dize)
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# İzin verilen CORS adresleri (Virgülle ayrılmış frontend alan adlarınız)
# Örnek: https://cyber-chat.pages.dev,https://customdomain.com
# Boş bırakılırsa yalnızca localhost / 127.0.0.1 / 0.0.0.0 ve Electron (file://) bağlantılarına izin verilir.
CORS_ORIGIN=

# Ters vekil (Nginx, Cloudflare vb.) arkasında gerçek istemci IP tespiti (true / false)
TRUST_PROXY=false

# SQLite veritabanı dosya yolu (Boş bırakılırsa src/database.sqlite kullanılır)
# Kalıcı Volume kullanan PaaS servisleri için örnek: /data/database.sqlite
DB_PATH=

# İsteğe Bağlı: Turso Bulut SQLite (libSQL) Yapılandırması
# Tanımlandığında yerel SQLite yerine Turso bulut veritabanı kullanılır.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
