# Sunucu Portu (PaaS servisleri otomatik atar, VPS için varsayılan 3000)
PORT=3000

# Node Ortamı (production / development)
NODE_ENV=production

# JWT İmzalamak için gizli anahtar (En az 32 karakter rastgele dize)
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# İzin verilen CORS adresleri (Virgülle ayrılmış frontend alan adlarınız)
# Örnek: https://cyber-chat.pages.dev,https://customdomain.com
# Boş bırakılırsa tüm originlere izin verilir (geliştirme aşaması için uygundur).
CORS_ORIGIN=

# SQLite veritabanı dosya yolu (Boş bırakılırsa proje kökündeki database.sqlite kullanılır)
# Kalıcı Volume kullanan PaaS servisleri için örnek: /data/database.sqlite
DB_PATH=
