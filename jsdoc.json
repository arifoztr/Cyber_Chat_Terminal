{
  "plugins": ["plugins/markdown"],
  "recurseDepth": 10,
  "source": {
    "include": [
      "src",
      "public",
      "electron",
      "README.md"
    ],
    "includePattern": ".+\\.js(doc|x)?$",
    "exclude": [
      "node_modules",
      "coverage",
      "dist",
      "dist-electron",
      "public/vendor"
    ],
    "excludePattern": "(^|\\/|\\\\)(node_modules|vendor|coverage|dist|dist-electron)(\\/|\\\\|$)"
  },
  "sourceType": "module",
  "tags": {
    "allowUnknownTags": true,
    "dictionaries": ["jsdoc", "closure"]
  },
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false
  },
  "opts": {
    "destination": "./docs/api",
    "recurse": true,
    "readme": "README.md",
    "encoding": "utf8"
  }
}
