{
  "appId": "com.cyberchat.terminal",
  "productName": "Cyber Chat Terminal",
  "copyright": "Copyright © 2025 Cyber Chat Team",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    "public/**/*",
    "package.json",
    "!**/node_modules/**/*",
    "!src/**/*",
    "!database.sqlite*",
    "!docs/**/*",
    "!.git/**/*"
  ],
  "extraMetadata": {
    "main": "electron/main.js"
  },
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "electron/assets/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Cyber Chat Terminal"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "electron/assets/icon.png",
    "category": "public.app-category.social-networking",
    "identity": null
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
