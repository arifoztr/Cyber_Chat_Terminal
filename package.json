{
  "name": "cyber",
  "version": "1.0.0",
  "description": "Cyber Chat Terminal - Secure E2EE Messenger",
  "desktopName": "com.cyberchat.terminal",
  "main": "src/server.js",
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "desktop:start": "electron electron/main.js",
    "desktop:build": "electron-builder --config electron-builder.json --win",
    "desktop:build:mac": "electron-builder --config electron-builder.json --mac --publish never",
    "desktop:build:linux": "electron-builder --config electron-builder.json --linux --publish never"
  },
  "keywords": [],
  "author": "Arif8054 <arifoz5354@gmail.com>",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "level": "^10.0.0",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "vitest": "^5.0.2"
  }
}
